<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#94C8FD"
    android:padding="16dp"
    android:id="@+id/main"
    >

        <!-- ส่วนของจอแสดงผล -->
    <TextView
        android:id = "@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="0"
        android:textSize="36sp"
        android:textColor="#008000"
        android:gravity="end"
        android:background="#2A3037"
        android:layout_marginBottom="12dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- แถวที่ 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/btnclear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="AC"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#42bd41" />

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="DEL"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#72d572" />

                <Button
                    android:id="@+id/btnMod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="%"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#a3e9a4" />

                <Button
                    android:id="@+id/btnDivide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="/"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#d0f8ce" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/btn7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="7"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#4dd0e1" />

                <Button
                    android:id="@+id/btn8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="8"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#80deea" />

                <Button
                    android:id="@+id/btn9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="9"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#b2ebf2" />

                <Button
                    android:id="@+id/btnMultipiy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="*"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#e0f7fa" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/btn4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="4"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#4db6ac" />

                <Button
                    android:id="@+id/btn5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="5"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#80cbc4" />

                <Button
                    android:id="@+id/btn6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="6"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#b2dfdb" />

                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="-"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#e0f2f1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/btn1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="1"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#ffb74d" />

                <Button
                    android:id="@+id/btn2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="2"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#ffcc80" />

                <Button
                    android:id="@+id/btn3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="3"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#ffe0b2" />

                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="+"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#fff3e0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/btnPlus_minus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="±"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#ff8a65" />

                <Button
                    android:id="@+id/btn0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="0"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#ffab91" />

                <Button
                    android:id="@+id/btnComma"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="."
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#ffccbc" />

                <Button
                    android:id="@+id/btnEqual"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="="
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#fbe9e7" />


            </LinearLayout>

    </LinearLayout>


</LinearLayout>
